<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Win7.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Win7.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="#FFD6E4F0" />
    <Setter Property="VerticalGridLinesBrush" Value="#FFD6E4F0" />
    <Setter Property="RowBackground" Value="#FFFFFFFF" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.PanelChrome}" />
    <Setter Property="Foreground" Value="{DynamicResource Win7.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Win7.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="DataGridRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.ControlFaceHover}" />
  </Style>

  <Style Selector="DataGridRow:selected">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.Selection}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="BorderBrush" Value="#FFD6E4F0" />
  </Style>
</Styles>
