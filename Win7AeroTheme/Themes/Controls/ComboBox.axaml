<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource Win7.Size.ControlMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Win7.Thickness.InputPadding}" />
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.ControlFace}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Win7.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Win7.CornerRadius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Win7.Brush.Text}" />
  </Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.ControlFaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Win7.Brush.FocusGlow}" />
  </Style>
  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Win7.Brush.FocusGlow}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.ControlFaceHover}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.Selection}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
</Styles>
