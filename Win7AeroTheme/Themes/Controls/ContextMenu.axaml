<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Win7.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
