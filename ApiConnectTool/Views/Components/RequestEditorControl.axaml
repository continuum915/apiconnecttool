<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApiConnectTool.ViewModels" xmlns:components="using:ApiConnectTool.Views.Components"
             xmlns:views="using:ApiConnectTool.Views"
             xmlns:models="using:ApiConnectTool.Models"
             xmlns:conv="using:ApiConnectTool.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             x:Class="ApiConnectTool.Views.Components.RequestEditorControl"
             x:DataType="vm:RequestTabViewModel"
             views:HelpContext.TopicId="requests">

    <UserControl.Resources>
        <conv:EnumIndexConverter x:Key="AssertionEnumIndex"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.pane-band">
            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.Pane}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style Selector="Border.grid-header">
            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.GridHeader}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,1"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="TextBox.code">
            <Setter Property="FontFamily" Value="{StaticResource ApiConnectTool.FontFamily.Monospace}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.Code.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Text}"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Button.row-remove">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip.Tip" Value="{DynamicResource Str.Grid.RemoveRow}"/>
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Grid.RemoveRow}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Request bar -->
        <Border Grid.Row="0" Padding="8,6"
                Background="{DynamicResource ApiConnectTool.Brush.Chrome}"
                BorderBrush="{DynamicResource ApiConnectTool.Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="RequestBar" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                <ComboBox x:Name="MethodPicker" Grid.Column="0" Margin="0,0,6,0" Width="100"
                          ItemsSource="{x:Static vm:RequestTabViewModel.Methods}"
                          SelectedIndex="{Binding SelectedMethodIndex}"
                          AutomationProperties.Name="{DynamicResource Str.RequestBar.Method}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontWeight="Bold"
                                       views:TokenBrush.Foreground="{Binding Converter={x:Static conv:TokenKeys.Method}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox x:Name="UrlTextBox" Grid.Column="1" Text="{Binding RequestUrl}"
                         PlaceholderText="{DynamicResource Str.RequestBar.UrlPlaceholder}"
                         AutomationProperties.Name="{DynamicResource Str.RequestBar.Url}"
                         FontFamily="{StaticResource ApiConnectTool.FontFamily.Monospace}"
                         Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13"/>

                <Button x:Name="SendButton" Grid.Column="2" Classes="accent" Padding="18,4" MinHeight="30"
                        Content="{DynamicResource Str.RequestBar.Send}"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding SendCommand}"/>

                <Button x:Name="CancelSendButton" Grid.Column="3" Padding="12,4" Margin="4,0,0,0" MinHeight="30"
                        Content="{DynamicResource Str.Dialog.Cancel}"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        IsEnabled="{Binding IsSending}"
                        Command="{Binding CancelCommand}"/>

                <Button x:Name="SaveRequestButton" Grid.Column="4" Padding="14,4" Margin="4,0,0,0" MinHeight="30"
                        Content="{DynamicResource Str.Dialog.Save}"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveCommand}"/>

                <Rectangle Grid.Column="5" Width="1" Margin="8,4" Fill="{DynamicResource ApiConnectTool.Brush.Border}"/>

                <!-- The default (redacted) and the explicit reveal-secrets copy are two direct
                     choices instead of a persistent toggle state. -->
                <Button x:Name="CopyAsCurlButton" Grid.Column="6" Classes="btn-menu" MinHeight="30"
                        Content="{DynamicResource Str.RequestBar.CopyCurl}"
                        VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{DynamicResource Str.RequestBar.CopyRedacted}" Click="OnCopyAsCurlRedactedClick"/>
                            <MenuItem Header="{DynamicResource Str.RequestBar.CopyRevealed}" Click="OnCopyAsCurlRevealedClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <CheckBox x:Name="FollowRedirectsCheckBox" Grid.Column="7" Margin="10,0,0,0"
                          Content="{DynamicResource Str.RequestBar.FollowRedirects}"
                          VerticalAlignment="Center"
                          IsChecked="{Binding FollowRedirects}"/>
            </Grid>
        </Border>

        <!-- Production strip -->
        <Border x:Name="ProductionStrip" Grid.Row="1"
                IsVisible="{Binding Summary.IsProduction}"
                Background="{DynamicResource ApiConnectTool.Brush.DangerBackground}"
                BorderBrush="{DynamicResource ApiConnectTool.Brush.DangerBorder}"
                BorderThickness="0,0,0,1" Padding="10,5"
                AutomationProperties.Name="{DynamicResource Str.ProductionStrip.Name}">
            <DockPanel>
                <components:AppIcon DockPanel.Dock="Left" Kind="Warning" Size="15" BrushKey="ApiConnectTool.Brush.Danger"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Summary.ProductionWarning}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ApiConnectTool.Brush.DangerText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Request tabs -->
        <TabControl x:Name="EditorTabControl" Grid.Row="2">

            <TabItem x:Name="ParamsTab" Header="{Binding Summary.ParamsHeader}" views:HelpContext.TopicId="requests">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="pane-band">
                        <TextBlock Text="{DynamicResource Str.Params.Title}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
                    </Border>
                    <DataGrid x:Name="QueryParamsGrid" Grid.Row="1"
                              ItemsSource="{Binding QueryParams}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="36" Binding="{ReflectionBinding IsEnabled}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.Key}" Width="*" Binding="{ReflectionBinding Key}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.Value}" Width="*" Binding="{ReflectionBinding Value}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.Description}" Width="*" Binding="{ReflectionBinding Description}"/>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-remove"
                                                Command="{Binding $parent[DataGrid].((vm:RequestTabViewModel)DataContext).RemoveRowCommand}"
                                                CommandParameter="{Binding}">
                                            <components:AppIcon Kind="Close" Size="12" BrushKey="ApiConnectTool.Brush.TextMuted"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="AuthorizationTab" Header="{DynamicResource Str.RequestTabs.Authorization}" views:HelpContext.TopicId="authorization">
                <components:AuthEditorControl DataContext="{Binding AuthEditor}"/>
            </TabItem>

            <TabItem x:Name="HeadersTab" Header="{Binding Summary.HeadersHeader}" views:HelpContext.TopicId="requests">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="pane-band">
                        <TextBlock Name="DefaultHeadersNotice" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"
                                   Text="{Binding DefaultHeadersDescription}"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding RequestHeaders}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="36" Binding="{ReflectionBinding IsEnabled}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.Key}" Width="*" Binding="{ReflectionBinding Key}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.Value}" Width="*" Binding="{ReflectionBinding Value}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Grid.Description}" Width="*" Binding="{ReflectionBinding Description}"/>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-remove"
                                                Command="{Binding $parent[DataGrid].((vm:RequestTabViewModel)DataContext).RemoveRowCommand}"
                                                CommandParameter="{Binding}">
                                            <components:AppIcon Kind="Close" Size="12" BrushKey="ApiConnectTool.Brush.TextMuted"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="BodyTab" Header="{DynamicResource Str.RequestTabs.Body}" views:HelpContext.TopicId="requests">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Classes="pane-band">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Text="{Binding BodyContentType}" Width="200"
                                     PlaceholderText="{DynamicResource Str.Body.ContentType}"
                                     AutomationProperties.Name="{DynamicResource Str.Body.ContentType}"/>
                            <StackPanel x:Name="BodyModeButtons" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource Str.Body.Mode}">
                                <RadioButton GroupName="BodyMode" Content="{DynamicResource Str.Body.None}"
                                             IsChecked="{Binding SelectedBodyModeIndex, Converter={x:Static conv:RadioIndexConverter.Instance}, ConverterParameter=0}"/>
                                <RadioButton GroupName="BodyMode" Content="{DynamicResource Str.Body.Raw}"
                                             IsChecked="{Binding SelectedBodyModeIndex, Converter={x:Static conv:RadioIndexConverter.Instance}, ConverterParameter=1}"/>
                                <RadioButton GroupName="BodyMode" Content="{DynamicResource Str.Body.FormData}"
                                             IsChecked="{Binding SelectedBodyModeIndex, Converter={x:Static conv:RadioIndexConverter.Instance}, ConverterParameter=2}"/>
                                <RadioButton GroupName="BodyMode" Content="{DynamicResource Str.Body.UrlEncoded}"
                                             IsChecked="{Binding SelectedBodyModeIndex, Converter={x:Static conv:RadioIndexConverter.Instance}, ConverterParameter=3}"/>
                                <RadioButton GroupName="BodyMode" Content="{DynamicResource Str.Body.Binary}"
                                             IsChecked="{Binding SelectedBodyModeIndex, Converter={x:Static conv:RadioIndexConverter.Instance}, ConverterParameter=4}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="12,8"
                            BorderBrush="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource ApiConnectTool.Brush.WarningBackground}"
                            IsVisible="{Binding RequestBodyIncompleteNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding RequestBodyIncompleteNotice}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ApiConnectTool.Brush.WarningText}"/>
                    </Border>
                    <TextBox x:Name="BodyTextBox" Grid.Row="2" Classes="code"
                             IsVisible="{Binding IsRawBody}"
                             Text="{Binding RequestBody}"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FormData}" IsVisible="{Binding IsFormBody}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="36" Binding="{ReflectionBinding IsEnabled}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.FormData.Key}" Width="*" Binding="{ReflectionBinding Key}"/>
                            <DataGridTemplateColumn Header="{DynamicResource Str.FormData.Type}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:KeyValueItem">
                                        <ComboBox SelectedIndex="{Binding SelectedFieldTypeIndex}">
                                            <ComboBoxItem Content="{DynamicResource Str.FormData.Text}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.FormData.File}"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Str.FormData.Value}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:KeyValueItem">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding Value}" IsVisible="{Binding !IsFile}"/>
                                            <TextBox Text="{Binding FilePath}" IsVisible="{Binding IsFile}"/>
                                            <Button Grid.Column="1" Content="{DynamicResource Str.FormData.Browse}" IsVisible="{Binding IsFile}"
                                                    Click="OnBrowseFormFileClick" Margin="6,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" IsVisible="{Binding IsBinaryBody}" Margin="12" Spacing="8">
                        <TextBox Text="{Binding BodyFilePath}"/>
                        <Button Content="{DynamicResource Str.FormData.Browse}" Click="OnBrowseBinaryFileClick" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="AssertionsTab" Header="{Binding Summary.AssertionsHeader}" views:HelpContext.TopicId="assertions-and-scripts">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="8">
                        <Button Content="{DynamicResource Str.Assertions.Add}" Command="{Binding AssertionTests.AddAssertionCommand}"/>
                        <Button Content="{DynamicResource Str.Assertions.Remove}" Command="{Binding AssertionTests.RemoveAssertionCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding AssertionTests.Assertions}" SelectedItem="{Binding AssertionTests.SelectedAssertion}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{DynamicResource Str.Assertions.Enabled}" Width="70" Binding="{ReflectionBinding IsEnabled}"/>
                            <DataGridTemplateColumn Header="{DynamicResource Str.Assertions.Kind}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedIndex="{ReflectionBinding Kind, Mode=TwoWay, Converter={StaticResource AssertionEnumIndex}}">
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Kind.StatusCode}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Kind.Header}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Kind.ResponseTime}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Kind.Body}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Kind.JsonPath}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Kind.Schema}"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Str.Assertions.Target}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Target}" MaxHeight="60" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{ReflectionBinding Target, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Str.Assertions.Operator}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedIndex="{ReflectionBinding Operator, Mode=TwoWay, Converter={StaticResource AssertionEnumIndex}}">
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.Equals}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.NotEquals}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.GreaterThan}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.LessThan}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.Exists}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.Contains}"/>
                                            <ComboBoxItem Content="{DynamicResource Str.Assertions.Operator.Matches}"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Str.Assertions.ExpectedValue}" Width="*" Binding="{ReflectionBinding ExpectedValue}"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Assertions.Description}" Width="*" Binding="{ReflectionBinding Description}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ScriptsTab" Header="{DynamicResource Str.Scripts.Tab}" views:HelpContext.TopicId="assertions-and-scripts">
                <Grid RowDefinitions="Auto,*,Auto,*">
                    <Border Grid.Row="0" Classes="grid-header">
                        <TextBlock Text="{DynamicResource Str.Scripts.PreRequest}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBox Grid.Row="1" Name="PreRequestScriptEditor" Classes="code" MinHeight="100"
                             AutomationProperties.Name="{DynamicResource Str.Scripts.PreRequest}"
                             Text="{Binding AssertionTests.PreRequestScript}"/>
                    <Border Grid.Row="2" Classes="grid-header">
                        <TextBlock Text="{DynamicResource Str.Scripts.Test}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBox Grid.Row="3" Name="TestScriptEditor" Classes="code" MinHeight="100"
                             AutomationProperties.Name="{DynamicResource Str.Scripts.Test}"
                             Text="{Binding AssertionTests.TestScript}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="{DynamicResource Str.RequestTabs.Settings}" views:HelpContext.TopicId="requests">
                <StackPanel Margin="20,16" Spacing="20" MaxWidth="480" HorizontalAlignment="Left">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Str.Request.Timeout}" FontWeight="SemiBold"/>
                        <NumericUpDown Value="{Binding TimeoutSeconds}" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Str.Settings.Proxy}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str.Settings.ProxyHelp}"
                                   TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
                        <TextBox Text="{Binding ProxyUrl}" PlaceholderText="{DynamicResource Str.Settings.ProxyPlaceholder}"
                                 AutomationProperties.Name="{DynamicResource Str.Settings.Proxy}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Str.Settings.Tls}" FontWeight="SemiBold"/>
                        <CheckBox Content="{DynamicResource Str.Settings.IgnoreTls}"
                                  IsChecked="{Binding IgnoreCertificateErrors}"/>
                        <TextBlock Text="{DynamicResource Str.Settings.InsecureTls}"
                                   TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource ApiConnectTool.Brush.WarningText}"
                                   IsVisible="{Binding IgnoreCertificateErrors}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
