<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApiConnectTool.ViewModels"
             xmlns:views="using:ApiConnectTool.Views"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="600"
             x:Class="ApiConnectTool.Views.Components.VariablesPaneControl"
             x:DataType="vm:VariablesPaneViewModel"
             views:HelpContext.TopicId="environments"
             AutomationProperties.Name="{DynamicResource Str.VariablesPane.Name}">

    <UserControl.Styles>
        <Style Selector="Border.pane-header">
            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.GridHeader}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ApiConnectTool.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="TextBlock.variable-name">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Variable}"/>
            <Setter Property="FontFamily" Value="{StaticResource ApiConnectTool.FontFamily.Monospace}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.variable-name.unresolved, TextBlock.variable-value.unresolved, TextBlock.variable-source.danger">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Danger}"/>
        </Style>
        <Style Selector="TextBlock.variable-source">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="120"/>
        </Style>
        <Style Selector="TextBlock.variable-value">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource ApiConnectTool.FontFamily.Monospace}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource ApiConnectTool.Brush.Surface}">
        <Border DockPanel.Dock="Top" Classes="pane-header">
            <DockPanel>
                <Button x:Name="InspectVariablesPaneButton" DockPanel.Dock="Right" Classes="btn-compact"
                        Content="{DynamicResource Str.VariablesPane.Inspect}"
                        ToolTip.Tip="{DynamicResource Str.VariablesPane.InspectTip}"
                        IsEnabled="{Binding HasTab}"
                        Command="{Binding InspectCommand}"/>
                <TextBlock Text="{DynamicResource Str.VariablesPane.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- General -->
        <StackPanel x:Name="GeneralSection" DockPanel.Dock="Bottom" IsVisible="{Binding HasTab}">
            <Border Classes="pane-header" BorderThickness="0,1,0,1">
                <TextBlock Text="{DynamicResource Str.VariablesPane.General}" FontWeight="SemiBold"/>
            </Border>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="8,6">
                <TextBlock Grid.Row="0" Classes="field-label" Text="{DynamicResource Str.VariablesPane.NameLabel}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RequestName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Classes="field-label" Text="{DynamicResource Str.VariablesPane.CollectionLabel}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CollectionName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Classes="field-label" Text="{DynamicResource Str.VariablesPane.FolderLabel}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="3" Classes="field-label" Text="{DynamicResource Str.VariablesPane.AuthLabel}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AuthText}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Classes="field-label" Text="{DynamicResource Str.VariablesPane.SavedLabel}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SavedState}"/>
            </Grid>
        </StackPanel>

        <!-- Precedence note -->
        <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Str.VariableInspector.Precedence}" TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"
                   Margin="8,6"/>

        <Panel>
            <TextBlock Text="{DynamicResource Str.VariablesPane.NoTab}" IsVisible="{Binding !HasTab}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}" Margin="8"/>
            <TextBlock Text="{DynamicResource Str.VariablesPane.Empty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}" Margin="8"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="VariableRows" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VariablePaneRow">
                            <Border BorderBrush="{DynamicResource ApiConnectTool.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="8,4">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Classes="variable-source"
                                                   Classes.danger="{Binding IsProductionSource}"
                                                   Text="{Binding Source}" ToolTip.Tip="{Binding Source}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="variable-name" Classes.unresolved="{Binding IsUnresolved}"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Classes="variable-value" Classes.unresolved="{Binding IsUnresolved}"
                                               Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
