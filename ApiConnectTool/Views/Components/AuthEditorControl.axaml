<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiConnectTool.ViewModels" x:Class="ApiConnectTool.Views.Components.AuthEditorControl" x:DataType="vm:AuthEditorViewModel">
<Grid ColumnDefinitions="180,*" Margin="12,16">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{DynamicResource Str.Auth.Editor.TypeLabel}"
                                   Opacity="0.6" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox Width="160" ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding SelectedAuthChoice}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AuthChoice"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock TextWrapping="Wrap" Margin="0,12,12,0" FontSize="11" Opacity="0.5"
                                   Text="{DynamicResource Str.Auth.Editor.Explanation}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ApiConnectTool.Brush.WindowBackground}"
                            CornerRadius="6" Padding="20">
                        <Panel>
                            <TextBlock Name="InheritanceSourceLabel" Text="{Binding InheritanceLabel}" IsVisible="{Binding IsInheriting}" TextWrapping="Wrap"/><!-- No Auth -->
                            <TextBlock Text="{DynamicResource Str.Auth.Editor.NoneExplanation}"
                                       Opacity="0.5"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding SelectedAuthTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>

                            <!-- Bearer Token -->
                            <StackPanel Spacing="12" IsVisible="{Binding SelectedAuthTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                                <TextBlock Text="{DynamicResource Str.Auth.Editor.Bearer}" FontWeight="SemiBold"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource Str.Auth.Editor.Token}" FontSize="12" Opacity="0.6"/>
                                    <TextBox Text="{Binding Auth.TokenText}" PlaceholderText="{DynamicResource Str.Auth.Editor.Token}" PasswordChar="{Binding PasswordChar}">
                                        <TextBox.InnerRightContent>
                                            <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                                    Theme="{StaticResource EmptyButton}"
                                                    Padding="4">
                                                <TextBlock Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToIconConverter}, ConverterParameter=SecretVisibility}"
                                                           FontSize="12"/>
                                            </Button>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Basic Auth -->
                            <StackPanel Spacing="12" IsVisible="{Binding SelectedAuthTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                                <TextBlock Text="{DynamicResource Str.Auth.Editor.Basic}" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.Username}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.Username}" PlaceholderText="{DynamicResource Str.Auth.Editor.Username}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.Password}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.PasswordText}" PlaceholderText="{DynamicResource Str.Auth.Editor.Password}" PasswordChar="{Binding PasswordChar}">
                                            <TextBox.InnerRightContent>
                                                <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Theme="{StaticResource EmptyButton}"
                                                        Padding="4">
                                                    <TextBlock Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToIconConverter}, ConverterParameter=SecretVisibility}" FontSize="12"/>
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- API Key -->
                            <StackPanel Spacing="12" IsVisible="{Binding SelectedAuthTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=3}">
                                <TextBlock Text="{DynamicResource Str.Auth.Editor.ApiKey}" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.HeaderName}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.ApiKeyHeaderName}" PlaceholderText="{DynamicResource Str.Auth.Editor.HeaderExample}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.QueryParam}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.ApiKeyQueryParam}" PlaceholderText="{DynamicResource Str.Auth.Editor.QueryExample}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.Value}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.TokenText}" PlaceholderText="{DynamicResource Str.Auth.Editor.Value}" PasswordChar="{Binding PasswordChar}">
                                            <TextBox.InnerRightContent>
                                                <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Theme="{StaticResource EmptyButton}"
                                                        Padding="4">
                                                    <TextBlock Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToIconConverter}, ConverterParameter=SecretVisibility}" FontSize="12"/>
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- OAuth 2.0 -->
                            <StackPanel Spacing="12" IsVisible="{Binding SelectedAuthTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=4}">
                                <TextBlock Text="{DynamicResource Str.Auth.Editor.OAuth2}" FontWeight="SemiBold"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource Str.Auth.Editor.GrantType}" FontSize="12" Opacity="0.6"/>
                                    <ComboBox Width="220" SelectedIndex="{Binding SelectedOAuthGrantTypeIndex}">
                                        <ComboBoxItem Content="{DynamicResource Str.Auth.Editor.Pkce}"/>
                                        <ComboBoxItem Content="{DynamicResource Str.Auth.Editor.ClientCredentials}"/>
                                    </ComboBox>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.ClientId}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.ClientId}" PlaceholderText="{DynamicResource Str.Auth.Editor.ClientId}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.ClientSecret}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.ClientSecretText}" PlaceholderText="{DynamicResource Str.Auth.Editor.ClientSecret}" PasswordChar="{Binding PasswordChar}">
                                            <TextBox.InnerRightContent>
                                                <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Theme="{StaticResource EmptyButton}"
                                                        Padding="4">
                                                    <TextBlock Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToIconConverter}, ConverterParameter=SecretVisibility}" FontSize="12"/>
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,6,0" Spacing="4"
                                                IsVisible="{Binding SelectedOAuthGrantTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.AuthorizationUrl}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.AuthorizationUrl}" PlaceholderText="{DynamicResource Str.Auth.Editor.AuthorizationUrlExample}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,12,0,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.TokenUrl}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.TokenUrl}" PlaceholderText="{DynamicResource Str.Auth.Editor.TokenUrlExample}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,6,0" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.Scope}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.Scope}" PlaceholderText="{DynamicResource Str.Auth.Editor.ScopeExample}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,12,0,0" Spacing="4"
                                                IsVisible="{Binding SelectedOAuthGrantTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                                        <TextBlock Text="{DynamicResource Str.Auth.Editor.RedirectUri}" FontSize="12" Opacity="0.6"/>
                                        <TextBox Text="{Binding Auth.RedirectUri}" PlaceholderText="{DynamicResource Str.Auth.Editor.RedirectUriExample}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding AuthorizationMessage}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Name="AuthorizeButton"
                                            Content="{DynamicResource Str.Auth.Editor.Authorize}"
                                            Command="{Binding AuthorizeCommand}"
                                            IsEnabled="{Binding !IsAuthorizing}"/>
                                    <Button Name="GetNewTokenButton"
                                            Content="{DynamicResource Str.Auth.Editor.GetNewToken}"
                                            Command="{Binding GetNewTokenCommand}"
                                            IsEnabled="{Binding !IsAuthorizing}"
                                            IsVisible="{Binding SelectedOAuthGrantTypeIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
                                    <Button Name="ClearTokenButton"
                                            Content="{DynamicResource Str.Auth.Editor.ClearToken}"
                                            Command="{Binding ClearTokenCommand}"
                                            IsEnabled="{Binding !IsAuthorizing}"/>
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Grid>
</UserControl>
