<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApiConnectTool.ViewModels"
             xmlns:components="using:ApiConnectTool.Views.Components"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="ApiConnectTool.Views.Components.MainWorkspaceControl"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Open request tab strip -->
        <components:OpenRequestsTabStripControl Grid.Row="0" />

        <!-- Request + Response editor -->
        <Panel Grid.Row="1" DataContext="{Binding ActiveTab}">
            
            <!-- ── VERTICAL LAYOUT ─────────────────────────────────── -->
            <Grid RowDefinitions="*,6,*" IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsVerticalLayout}">
                <components:RequestEditorControl Grid.Row="0" />
                <GridSplitter Grid.Row="1"
                              ResizeDirection="Rows"
                              Background="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>
                <components:ResponseViewerControl Grid.Row="2" />
            </Grid>

            <!-- ── HORIZONTAL LAYOUT ────────────────────────────────── -->
            <Grid ColumnDefinitions="*,6,*" IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsVerticalLayout}">
                <components:RequestEditorControl Grid.Column="0" />
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>
                <components:ResponseViewerControl Grid.Column="2" />
            </Grid>

        </Panel>
    </Grid>
</UserControl>
