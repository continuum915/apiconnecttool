<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApiConnectTool.ViewModels"
             xmlns:cv="using:ApiConnectTool.Converters"
             xmlns:views="using:ApiConnectTool.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="ApiConnectTool.Views.Components.OpenRequestsTabStripControl"
             x:DataType="vm:MainWindowViewModel">

    <!-- Fixed Height, like the request editor's 52px URL bar (RequestEditorControl.axaml) -
         both the "+" button and the tab list center within it, so the row's height doesn't
         depend on whether the horizontal scrollbar is showing, and there's always headroom
         below the tab content (close button, unsaved-changes dot) for that auto-hide overlay
         scrollbar to sit in without covering anything. -->
    <Border Height="52"
            BorderBrush="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource ApiConnectTool.Brush.Chrome}">
        <DockPanel VerticalAlignment="Center">
            <Button DockPanel.Dock="Right"
                    Content="+" Padding="14,8"
                    VerticalAlignment="Center"
                    Command="{Binding AddTabCommand}"
                    ToolTip.Tip="New Request"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <ListBox ItemsSource="{Binding OpenRequests}"
                         SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         Background="Transparent"
                         Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.Surface}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequestTabViewModel">
                            <Border BorderBrush="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"
                                    BorderThickness="0,0,1,0"
                                    Background="Transparent">
                                <DockPanel Margin="12,8">
                                    <Button DockPanel.Dock="Right" 
                                            Content="×" Padding="4,0" FontSize="14"
                                            Background="Transparent"
                                            Margin="6,0,0,0"
                                            ToolTip.Tip="{DynamicResource Str.Tabs.Close}"
                                            Command="{ReflectionBinding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Method}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   views:TokenBrush.Foreground="{Binding Method, Converter={x:Static cv:TokenKeys.Method}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="120"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="●"
                                                   IsVisible="{Binding IsDirty}"
                                                   Foreground="{DynamicResource ApiConnectTool.Brush.AccentText}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Unsaved changes"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </Border>

</UserControl>
