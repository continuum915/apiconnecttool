<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="180"
        x:Class="ApiConnectTool.Views.ProductionSendConfirmationWindow"
        Title="{DynamicResource Str.ProductionSend.Title}"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="MessageText"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Classes="btn-dialog" Content="{DynamicResource Str.Dialog.Cancel}" IsCancel="True" IsDefault="True"/>
            <Button x:Name="SendButton" Classes="accent btn-dialog" Content="{DynamicResource Str.ProductionSend.Send}"/>
        </StackPanel>
    </Grid>

</Window>
