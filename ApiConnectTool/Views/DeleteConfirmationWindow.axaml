<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApiConnectTool.Views.DeleteConfirmationWindow"
        Title="Confirm deletion"
        Width="440" Height="190"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Classes="btn-dialog" Content="Cancel" IsCancel="True" IsDefault="True"/>
            <Button x:Name="DeleteButton" Classes="accent btn-dialog" Content="Delete"/>
        </StackPanel>
    </Grid>
</Window>
