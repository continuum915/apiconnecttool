<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApiConnectTool.Views.ResetOverridesConfirmationWindow" Title="{DynamicResource Str.Variables.ResetAllConfirm}"
        Width="480" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto" Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Classes="btn-dialog" Content="{DynamicResource Str.Dialog.Cancel}" IsCancel="True" IsDefault="True"/>
            <Button x:Name="ResetButton" Classes="accent btn-dialog" Content="{DynamicResource Str.Variables.ResetAllConfirm}"/>
        </StackPanel>
    </Grid>
</Window>
