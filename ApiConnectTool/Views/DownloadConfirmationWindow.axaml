<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApiConnectTool.Views.DownloadConfirmationWindow"
        Title="{DynamicResource Str.Response.DownloadConfirmTitle}"
        Width="460" Height="220" CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Classes="btn-dialog" Content="{DynamicResource Str.Dialog.Cancel}" IsCancel="True" IsDefault="True"/>
            <Button x:Name="SendButton" Classes="accent btn-dialog" Content="{DynamicResource Str.Response.SendAgain}"/>
        </StackPanel>
    </Grid>
</Window>
