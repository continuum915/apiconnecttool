<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiConnectTool.ViewModels"
        x:Class="ApiConnectTool.Views.MoveRequestWindow"
        Title="{DynamicResource Str.MoveRequest.Title}"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <!-- An always-visible list rather than a dropdown: every collection (bold) with its folders
         listed by their own names underneath, indented by depth, so no folder can be cut off
         behind a long collection name or a clipped popup. -->
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap"/>
        <ListBox Grid.Row="1" x:Name="LocationList" Height="300" Margin="0,12,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SaveDestination">
                    <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding DisplayPath}">
                        <Border Width="{Binding IndentWidth}"/>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                   IsVisible="{Binding IsCollection}"/>
                        <TextBlock Text="{Binding Label}"
                                   IsVisible="{Binding !IsCollection}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Classes="btn-dialog" Content="{DynamicResource Str.Dialog.Cancel}" IsCancel="True"/>
            <Button x:Name="MoveButton" Classes="accent btn-dialog" Content="{DynamicResource Str.MoveRequest.Move}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
