<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiConnectTool.ViewModels" xmlns:components="using:ApiConnectTool.Views.Components"
        xmlns:views="using:ApiConnectTool.Views"
        xmlns:models="using:ApiConnectTool.Models"
        xmlns:cv="using:ApiConnectTool.Converters"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="580"
        x:Class="ApiConnectTool.Views.EnvironmentEditorWindow"
        x:DataType="vm:EnvironmentEditorViewModel"
        Title="{Binding Title}"
        Width="980" Height="580"
        MinWidth="680" MinHeight="400"
        Background="{DynamicResource ApiConnectTool.Brush.WindowBackground}"
        views:HelpContext.TopicId="environments">

    <Design.DataContext>
        <vm:EnvironmentEditorViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.window-toolbar">
            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.Chrome}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ApiConnectTool.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.window-footer">
            <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.Chrome}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ApiConnectTool.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="TextBlock.list-heading">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style Selector="TextBlock.tag">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.tag.active">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Success}"/>
        </Style>
        <Style Selector="TextBlock.tag.prod">
            <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Danger}"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="window-toolbar">
            <DockPanel>
                <TextBox x:Name="EnvironmentSearchTextBox" DockPanel.Dock="Right" Width="200" Text="{Binding SearchText}"
                         PlaceholderText="{DynamicResource Str.EnvironmentSearch.Placeholder}"
                         ToolTip.Tip="{DynamicResource Str.EnvironmentSearch.Placeholder}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasScopes}">
                        <TextBlock Text="{DynamicResource Str.EnvironmentEditor.Scope}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ScopeSelector" Width="200" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                                  AutomationProperties.Name="{DynamicResource Str.EnvironmentEditor.Scope}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EnvironmentScopeChoice">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource ApiConnectTool.Brush.Border}"/>
                    </StackPanel>
                    <Button x:Name="AddEnvironmentButton" Classes="btn-default" Content="{DynamicResource Str.EnvironmentEditor.AddEnvironment}"
                            Command="{Binding AddEnvironmentCommand}"/>
                    <Button x:Name="DuplicateEnvironmentButton" Classes="btn-default" Content="{DynamicResource Str.EnvironmentEditor.Duplicate}"
                            Click="OnDuplicateEnvironmentClick" IsEnabled="{Binding CanEditEnvironment}"/>
                    <Button x:Name="DeleteEnvironmentButton" Classes="btn-default" Content="{DynamicResource Str.EnvironmentEditor.Delete}"
                            Click="OnDeleteEnvironmentClick" IsEnabled="{Binding CanEditEnvironment}"/>
                    <Button x:Name="CopyToCollectionButton" Classes="btn-default" Content="{DynamicResource Str.EnvironmentTransfer.CopyAction}"
                            IsVisible="{Binding IsGlobalScope}" IsEnabled="{Binding CanTransferToCollection}"
                            Tag="copy" Click="OnTransferEnvironmentClick"/>
                    <Button x:Name="MoveToCollectionButton" Classes="btn-default" Content="{DynamicResource Str.EnvironmentTransfer.MoveAction}"
                            IsVisible="{Binding IsGlobalScope}" IsEnabled="{Binding CanTransferToCollection}"
                            Tag="move" Click="OnTransferEnvironmentClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Classes="window-footer">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SetActiveButton" Classes="btn-dialog" Content="{DynamicResource Str.EnvironmentEditor.SetActive}"
                            Command="{Binding SetActiveCommand}"/>
                    <Button x:Name="CloseEditorButton" Classes="btn-dialog" Content="{DynamicResource Str.EnvironmentEditor.Close}"
                            Click="OnCloseClick" IsCancel="True"/>
                </StackPanel>
                <TextBlock x:Name="ActiveSummaryText" Text="{Binding ActiveSummary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="230,5,*" Background="{DynamicResource ApiConnectTool.Brush.Surface}">

            <!-- Environment list -->
            <Grid Grid.Column="0">
                <ListBox x:Name="EnvironmentList" Background="Transparent"
                         ItemsSource="{Binding DisplayEnvironments}"
                         SelectedItem="{Binding SelectedEnvironment, Mode=OneWay}" SelectionChanged="OnEnvironmentSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:RequestEnvironment">
                            <StackPanel>
                                <TextBlock Classes="list-heading" Text="{DynamicResource Str.EnvironmentEditor.EnvironmentsHeading}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static cv:EnvironmentListConverters.IsFirstEnvironment}">
                                            <Binding/>
                                            <Binding Path="$parent[Window].DataContext"/>
                                            <Binding Path="$parent[ListBox].ItemCount"/>
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <TextBlock Classes="tag active" Text="{DynamicResource Str.EnvironmentEditor.ActiveTag}">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static cv:EnvironmentListConverters.IsActive}">
                                                <Binding/>
                                                <Binding Path="$parent[Window].DataContext"/>
                                                <Binding Path="$parent[Window].((vm:EnvironmentEditorViewModel)DataContext).ActiveSummary"/>
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                    <TextBlock Classes="tag prod" Text="{DynamicResource Str.Environment.ProdTag}" IsVisible="{Binding IsProduction}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{DynamicResource Str.EnvironmentSearch.Empty}" IsVisible="{Binding IsScopeEmpty}" TextWrapping="Wrap" Margin="8"
                           Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
                <TextBlock Text="{DynamicResource Str.EnvironmentSearch.NoMatches}" IsVisible="{Binding HasNoMatches}" TextWrapping="Wrap" Margin="8"
                           Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          Background="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>

            <!-- Selected environment -->
            <Grid Grid.Column="2" Margin="12,10" RowDefinitions="Auto,Auto,Auto,*"
                  IsVisible="{Binding SelectedEnvironment, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Grid.Row="0" IsVisible="{Binding CanEditEnvironment}" Spacing="6" Margin="0,0,0,8">
                    <TextBox x:Name="EnvironmentNameTextBox" Text="{Binding SelectedEnvironment.Name}"
                             TextChanged="OnEnvironmentNameChanged"
                             PlaceholderText="{DynamicResource Str.EnvironmentEditor.NamePlaceholder}"
                             AutomationProperties.Name="{DynamicResource Str.EnvironmentEditor.NamePlaceholder}"
                             FontWeight="SemiBold"/>
                    <CheckBox x:Name="ProductionCheckBox" Content="{DynamicResource Str.EnvironmentEditor.Production}"
                              IsChecked="{Binding SelectedEnvironment.IsProduction}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" IsVisible="{Binding IsScopeVariablesSelected}" Margin="0,0,0,8" Spacing="2">
                    <TextBlock Text="{Binding SelectedEnvironment.Name}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScopeVariablesNoteText" Text="{Binding ScopeVariablesNote}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"/>
                </StackPanel>
                <TextBlock Grid.Row="2" x:Name="OutsideFilterText" Text="{DynamicResource Str.EnvironmentSearch.OutsideFilter}"
                           IsVisible="{Binding IsSelectedOutsideFilter}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <components:VariableEditorControl Grid.Row="3" DataContext="{Binding VariableEditor}"/>
            </Grid>

            <TextBlock Grid.Column="2" Margin="12,0,0,0"
                       Text="{DynamicResource Str.EnvironmentEditor.NoSelection}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ApiConnectTool.Brush.TextMuted}"
                       IsVisible="{Binding SelectedEnvironment, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
        </Grid>
    </DockPanel>

</Window>
