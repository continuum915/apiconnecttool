<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiConnectTool.ViewModels" xmlns:models="using:ApiConnectTool.Models"
        x:Class="ApiConnectTool.Views.EnvironmentTransferWindow" x:DataType="vm:EnvironmentTransferViewModel"
        Title="{Binding Title}" Width="520" MinWidth="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{DynamicResource Str.EnvironmentTransfer.Collection}"/>
        <ComboBox x:Name="CollectionPicker" ItemsSource="{Binding Collections}" SelectedItem="{Binding TargetCollection}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:RequestCollection">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{DynamicResource Str.EnvironmentDuplicate.Name}"/>
        <TextBox x:Name="NameTextBox" Text="{Binding Name}"/>
        <CheckBox Content="{DynamicResource Str.EnvironmentDuplicate.CopyOverrides}" IsChecked="{Binding CopyOverrides}"/>
        <CheckBox Content="{DynamicResource Str.EnvironmentDuplicate.IncludeSecrets}" IsChecked="{Binding IncludeSecretValues}"/>
        <TextBlock Text="{DynamicResource Str.EnvironmentTransfer.Help}" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Str.EnvironmentTransfer.MoveHelp}" TextWrapping="Wrap" IsVisible="{Binding IsMove}"/>
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Str.Dialog.Cancel}" Classes="btn-dialog" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" Classes="accent btn-dialog" Click="OnConfirmClick"
                    IsDefault="True" IsEnabled="{Binding CanTransfer}"/>
        </StackPanel>
    </StackPanel>
</Window>
