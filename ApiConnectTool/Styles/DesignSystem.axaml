                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Syntax.Key" Color="#FFCC99EE"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Syntax.String" Color="#FF8FCF92"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Syntax.Number" Color="#FF7DB6F4"/>
