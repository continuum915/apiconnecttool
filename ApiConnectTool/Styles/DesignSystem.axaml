                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Method.Put" Color="#FF7DB6F4"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Method.Patch" Color="#FFC19AF0"/>
