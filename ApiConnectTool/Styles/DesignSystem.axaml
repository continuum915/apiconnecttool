                    <Color x:Key="SystemAccentColorDark1">#FF4C8FE6</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF4C8FE6</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF4C8FE6</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF4C8FE6</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF4C8FE6</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF6AA3EE</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
        Button conventions (design system):
          - Primary action: Classes="accent" (Fluent's built-in accent style -
            already the pattern for Send/Import/Send Anyway; keep using it,
            don't reinvent it).
          - Secondary/destructive action: no class, default Button style.
          - Compact action (row-level buttons inside a list item, e.g. a
            future collection/request row's Actions trigger): Classes="btn-compact".
          - Menu trigger (a button that opens a MenuFlyout of further
            actions, e.g. a future "Import" or "Actions" button):
            Classes="btn-menu".
          No icon-only buttons: every button styled with these classes is
          expected to carry a short text label, per the plan's chosen icon
          strategy - these style rules deliberately don't touch Content.
    -->
    <Style Selector="Button.btn-compact">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    </Style>

    <Style Selector="Button.btn-default">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <Style Selector="Button.btn-menu">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <!-- Dialog action (a modal window's bottom-row Cancel/Confirm buttons - e.g.
         ProductionSendConfirmationWindow, CurlImportWindow). Added in 4.5e:
         three of the four dialogs had already independently landed on the
         same 14,6 padding by coincidence: promoted to a real shared class
         so it's consistency by construction, not by accident. -->
    <Style Selector="Button.btn-dialog">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <!--
        Fixes a tab-strip typography mismatch:
        RequestEditorControl's and ResponseViewerControl's TabControls never
        set FontSize on TabItem, so they fell back to Fluent's larger
        default next to everything else in the app, which is hand-sized to
        the scale above. This is the one rule in this file that applies
        immediately, everywhere, with no other file needing to change.
    -->
    <!-- Classic grids: grid-line, header and alternate-row tokens for every DataGrid. -->
    <Style Selector="DataGrid">
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ApiConnectTool.Brush.BorderSubtle}"/>
        <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource ApiConnectTool.Brush.Surface}"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
    </Style>
    <Style Selector="DataGridRow:nth-child(2n)">
        <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.GridAlternateRow}"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ApiConnectTool.Brush.GridHeader}"/>
        <Setter Property="Foreground" Value="{DynamicResource ApiConnectTool.Brush.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

</Styles>
