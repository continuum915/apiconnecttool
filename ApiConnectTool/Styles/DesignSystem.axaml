<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared spacing/typography tokens and button conventions.

        The TabItem rule at the bottom applies everywhere, so both
        TabControls pick it up with no per-file edit.
    -->

    <Styles.Resources>
        <ResourceDictionary>

            <!-- Spacing scale: 4 / 8 / 12 / 16 / 24. Use for Margin/Spacing/
                 Padding wherever a screen is being touched by a later
                 milestone - do not introduce a sixth value without updating
                 this comment and the plan doc. -->
            <x:Double x:Key="SpacingXS">4</x:Double>
            <x:Double x:Key="SpacingS">8</x:Double>
            <x:Double x:Key="SpacingM">12</x:Double>
            <x:Double x:Key="SpacingL">16</x:Double>
            <x:Double x:Key="SpacingXL">24</x:Double>

            <!-- Typography scale. Caption = the smallest metadata text
                 (timestamps, status subtext); Body = default control/text
                 size; Subheading = tab labels and small section headers;
                 Heading = section emphasis; Title = top-level article titles. -->
            <x:Double x:Key="FontSizeCaption">11</x:Double>
            <x:Double x:Key="FontSizeBody">12</x:Double>
            <x:Double x:Key="FontSizeSubheading">13</x:Double>
            <x:Double x:Key="FontSizeHeading">15</x:Double>
            <x:Double x:Key="FontSizeTitle">18</x:Double>

            <FontFamily x:Key="ApiConnectTool.FontFamily.Monospace">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
