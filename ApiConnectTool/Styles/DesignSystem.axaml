                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Accent" Color="#FF1F5FBF"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.AccentBorder" Color="#FF174C9A"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.OnAccent" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.AccentText" Color="#FF1F5FBF"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Success" Color="#FF1C6E2F"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SuccessBackground" Color="#FFE2F2E6"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SuccessBorder" Color="#FFA8D5B3"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SuccessFill" Color="#FF4E9F62"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Danger" Color="#FFB3261E"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.DangerBackground" Color="#FFFBEAE8"/>
