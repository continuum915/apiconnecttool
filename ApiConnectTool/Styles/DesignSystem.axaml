                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Success" Color="#FF7FCB8D"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SuccessBackground" Color="#FF1E3626"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SuccessBorder" Color="#FF2F5A3B"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SuccessFill" Color="#FF3F8A52"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Danger" Color="#FFF2867A"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.DangerBackground" Color="#FF3A2423"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.DangerBorder" Color="#FF5E3330"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.DangerText" Color="#FFF6C3BC"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.DangerFill" Color="#FFB4453C"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.OnDanger" Color="#FF2A0C09"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Warning" Color="#FFE0A63C"/>
