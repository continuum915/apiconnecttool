                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Chrome" Color="#FFF3F4F6"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.StatusBar" Color="#FFE1E4E8"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Pane" Color="#FFF4F5F7"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Input" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Border" Color="#FFBFC4CB"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.BorderSubtle" Color="#FFDDE0E5"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Grip" Color="#FF9AA1AB"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Text" Color="#FF1D2126"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.TextMuted" Color="#FF535B67"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Hover" Color="#FFE4E7EB"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Selection" Color="#FFCFE0F7"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.SelectionText" Color="#FF0F2340"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.GridHeader" Color="#FFEEF0F3"/>
