                    <Color x:Key="SystemAccentColorDark1">#FF1F5FBF</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF174C9A</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF174C9A</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF1F5FBF</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF1F5FBF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF1F5FBF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.WindowBackground" Color="#FF2B2D31"/>
                    <SolidColorBrush x:Key="ApiConnectTool.Brush.Surface" Color="#FF1E1F22"/>
